"""
Local production settings for STANDALONE mode. Copy this file as
`settings_local.py` (gitignored) and edit. settings.py imports it LAST,
and only when USE_MULTITENANT is off:

    else:
        from .settings_base import *
        from .settings_local import *

The multi-tenant counterpart is settings_local_multitenant.py.example. The two are
separate files on purpose: the multi-tenant one pins ENGINE to the django-tenants
backend and declares tenant_* shards, which must never reach a standalone run.

Anything here overrides the defaults from settings_base.py.

Replace `example.com` with your real apex domain.
Run `openssl rand -hex 50` to generate a SECRET_KEY.
"""

# Re-import the names we mutate in-place (DATABASES, CACHES are dicts).
#
# NOTE: there are no _aurora_db_options / _proxy_db_options here. Those helpers are
# multi-tenant deployment topology (Aurora + RDS Proxy) and live in
# settings_multitenant.py; the standalone dispatcher branch does not re-export them.
# If a standalone deployment ever does need verify-full TLS, spell the OPTIONS out
# below rather than reaching into the MT layer.
from .settings import DATABASES, CACHES


# --------------------------------------------------------------------------
# Core
# --------------------------------------------------------------------------

DEBUG = False

SECRET_KEY = "replace-me-with-a-long-random-string"

ALLOWED_HOSTS = [".example.com", "example.com"]


# --------------------------------------------------------------------------
# TLS / proxy - ALB terminates HTTPS, nginx forwards X-Forwarded-Proto.
# --------------------------------------------------------------------------

SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")
USE_X_FORWARDED_HOST = True
SESSION_COOKIE_SECURE = True
CSRF_COOKIE_SECURE = True
SESSION_COOKIE_DOMAIN = ".example.com"
CSRF_COOKIE_DOMAIN    = ".example.com"

# Required for Django admin POST behind TLS proxy.
CSRF_TRUSTED_ORIGINS = [
    "https://example.com",
    "https://*.example.com",
]


# --------------------------------------------------------------------------
# CORS - production runs frontend and backend behind a single ALB on the
# same origin, so CORS is effectively unused in prod.
# --------------------------------------------------------------------------

CORS_ALLOW_ALL_ORIGINS = False
CORS_ALLOWED_ORIGIN_REGEXES = [
    r"^https://([a-z0-9-]+\.)?example\.com(:\d+)?$",
]


# --------------------------------------------------------------------------
# Database - ONE database, no shards. The ENGINE stays the plain PostGIS
# backend from settings_base.py: the django-tenants backend belongs to the
# other mode and must not appear here.
# --------------------------------------------------------------------------

DATABASES["default"] = {
    **DATABASES["default"],
    "NAME":         "tenants_back",
    "USER":         "app",
    "PASSWORD":     "replace-me",
    "HOST":         "db.internal.example.com",
    "PORT":         "5432",
    # Raise only where the topology is known: the connection count the server sees
    # is backend_hosts x gunicorn_workers. See "Connection sizing" in
    # deploy/DATABASE_SETUP.md.
    "CONN_MAX_AGE": 60,
}


# --------------------------------------------------------------------------
# Redis - one cluster for the app cache + sessions.
# maxmemory-policy=allkeys-lru is fine (disposable cache).
# --------------------------------------------------------------------------

# Standalone has ONE cache alias — sessions ride it too (there is no tenant scoping here,
# so nothing to separate). Multi-tenant is where the alias list grows.
CACHES["default"]["LOCATION"] = "redis://app.xxx.cache.amazonaws.com:6379/0"
